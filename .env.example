# ============================================
# Velora - Buyer Setup Guide
# ============================================
# HOW TO USE THIS FILE:
# 1. Copy this file and rename copy to .env.local
# 2. Fill ONLY your own values below
# 3. NEVER share .env.local with anyone
# 4. NEVER upload .env.local to GitHub
# ============================================

# ============================================
# 1. DATABASE - Cloudflare D1
# ============================================
# Where to get it:
# 1. Go to https://dash.cloudflare.com
# 2. Go to Workers & Pages > D1 SQL Database
# 3. Click Create Database > Name it velora-db
# 4. Copy the Database ID from there and paste below

D1_DATABASE_ID=paste_your_own_d1_database_id_here

# ============================================
# 2. JWT SECRET - For Login Security
# ============================================
# What is this?
# This is used to keep users logged in securely.
# You can make your own - Any long random text.
# Example: Go to https://randomkeygen.com and copy any long key
# DO NOT use someone else's key. Create your own.

JWT_SECRET=paste_your_own_long_random_text_here

# ============================================
# 3. EMAIL - Resend API Key (For OTP Login)
# ============================================
# Where to get it:
# 1. Go to https://resend.com
# 2. Create free account
# 3. Go to API Keys > Create API Key
# 4. Copy the key starting with re_ and paste below
# Without this, OTP Login will NOT work.

RESEND_API_KEY=paste_your_own_resend_api_key_here

# ============================================
# 4. YOUR LICENSE KEY - To Unlock Dashboard
# ============================================
# Direct Buyer (India):
# - Use the License Key given by Founder on WhatsApp / Email
# - Example: VELORA-XXXX-XXXX
#
# Gumroad Buyer (Global):
# - Use the License Key given by Gumroad after payment
# - Example: A1B2C3D4-E5F6-XXXX-XXXX
#
# This key is used to activate your copy. Do NOT share it.

LICENSE_KEY=paste_your_own_license_key_here

# ============================================
# 5. GUMROAD PRODUCT ID - Only For Gumroad Sellers
# ============================================
# If you bought Direct from Velora (WhatsApp / UPI):
# - Leave this EMPTY. You do NOT need this.
# - Direct Buyer does NOT use Gumroad.
#
# If you want to sell Velora on Gumroad yourself (Enterprise only):
# - Create product on https://gumroad.com
# - Copy Product ID from Gumroad dashboard and paste below
# - For normal Pro buyers, leave it empty.

GUMROAD_PRODUCT_ID=

# ============================================
# 6. YOUR SITE URL
# ============================================
# Local testing:
# SITE_URL=http://localhost:3000
#
# After deploying to Cloudflare:
# Change this to your live domain
# Example: https://your-site.workers.dev

SITE_URL=http://localhost:3000
