# ============================================
# Velora - Buyer Setup Guide
# ============================================
# HOW TO USE THIS FILE:
# 1. Copy this file and rename copy to .env.local
# 2. Fill ONLY your own values below
# 3. NEVER share .env.local with anyone
# 4. NEVER upload .env.local to GitHub
# 5. For Cloudflare Deploy: Same values go in
#    Cloudflare Dashboard > Workers & Pages > Settings > Variables
# ============================================

# ============================================
# 1. AUTH SECRET - For Login Security
# ============================================
# This is used to keep users logged in securely.
# You can make your own - Any long random text (32+ characters).
# Go to https://randomkeygen.com and copy any long key
# DO NOT use someone else's key. Create your own.
# This SAME value is used in Cloudflare as BETTER_AUTH_SECRET

BETTER_AUTH_SECRET=paste_your_own_long_random_text_here
JWT_SECRET=paste_same_value_as_BETTER_AUTH_SECRET_here

# ============================================
# 2. YOUR SITE URL - VERY IMPORTANT
# ============================================
# Local testing:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# BETTER_AUTH_URL=http://localhost:3000
#
# After deploying to Cloudflare:
# Change BOTH to your live domain
# Example: https://your-site.workers.dev
# NOTE: BETTER_AUTH_URL and NEXT_PUBLIC_APP_URL must ALWAYS be same.

NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# ============================================
# 3. EMAIL - Resend API Key (For OTP Login)
# ============================================
# Where to get it:
# 1. Go to https://resend.com
# 2. Create free account
# 3. Go to API Keys > Create API Key
# 4. Copy the key starting with re_ and paste below
# Without this, OTP Login will NOT work.
# In Cloudflare, this is named RESEND_API_KEY

RESEND_API_KEY=paste_your_own_resend_api_key_here

# Email from which OTP will be sent
# In Cloudflare, this is named RESEND_FROM (not RESEND_FROM_EMAIL)
# Example: onboarding@resend.dev (for testing)
# After adding your domain in Resend, use: noreply@yourdomain.com
RESEND_FROM=onboarding@resend.dev

# NOTE: With onboarding@resend.dev, OTP will go ONLY to your own email.
# For public users, you MUST verify your own domain in Resend
# and change above to noreply@yourdomain.com

# ============================================
# 4. YOUR LICENSE KEY - To Unlock Dashboard
# ============================================
# Direct Buyer (India):
# - Use the License Key given by Founder on WhatsApp / Email
# - Example: VELORA-XXXX-XXXX
#
# Gumroad Buyer (Global):
# - Use the License Key given by Gumroad after payment
#
# This key is used to activate your copy. Do NOT share it.
# In Cloudflare, this is named VELORA_KEYS
# You can put multiple keys comma-separated: VELORA-111,VELORA-222

VELORA_KEYS=paste_your_own_license_key_here
LICENSE_KEY=paste_your_own_license_key_here

# ============================================
# 5. GUMROAD PRODUCT ID - Only For Gumroad Sellers
# ============================================
# If you bought Direct from Velora (WhatsApp / UPI):
# - Leave this EMPTY. You do NOT need this.
#
# If you want to sell Velora on Gumroad yourself (Enterprise only):
# - Create product on https://gumroad.com
# - Copy Product ID from Gumroad dashboard and paste below
# - For normal Pro buyers, leave it empty.

GUMROAD_PRODUCT_ID=

# ============================================
# 6. DATABASE - Cloudflare D1 (IMPORTANT)
# ============================================
# D1 Database ID is NOT written here.
# It is written in wrangler.json file.
# Steps:
# 1. Go to https://dash.cloudflare.com
# 2. Workers & Pages > Storage & Databases > D1 SQL Database > Create Database
# 3. Name it anything, e.g. velora_db
# 4. Copy Database ID
# 5. Open wrangler.json in this project and paste ID there
# 6. In Cloudflare Dashboard > Workers & Pages > Settings > Bindings
#    Add Binding: Type = D1 Database, Variable name = DB, Database = velora_db
# Do NOT paste D1 ID in this .env file.

# ============================================
# 7. STRIPE - Buyer Payment System
# ============================================
# Buyer will use their OWN Stripe account.
# Money will go directly to buyer's Stripe account, not to Velora.
# Steps:
# 1. Go to https://dashboard.stripe.com
# 2. Create free account - DO NOT use someone else's / Connect account
#    If you see "Quora, Inc." or any other company name on top,
#    Click it > Create a new Stripe account > Create for your own business.
# 3. Complete KYC: PAN, Bank Account, Aadhaar / Address proof
# 4. Go to Developers -> API Keys
# 5. Copy keys below
# Use test keys (sk_test_ / pk_test_) for testing.
# Use live keys (sk_live_ / pk_live_) for real payments.
# NEVER share sk_live_ key with anyone. It is like your bank key.

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

# Webhook Secret - For Payment Confirmation
# Steps to get it:
# 1. Stripe Dashboard > Developers > Webhooks > Add Endpoint
# 2. Endpoint URL = https://your-site.workers.dev/api/stripe/webhook
# 3. Select Events: checkout.session.completed
# 4. Click Reveal > Copy key starting with whsec_
# If you are just testing / demo, you can use dummy:
# STRIPE_WEBHOOK_SECRET=whsec_dummy_test_1234567890
# But for real payments, you MUST put real whsec_ key.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Stripe Product Price IDs
# Get these from Stripe Dashboard -> Products -> Create Product -> Copy Price ID
# NEXT_PUBLIC_ is required because Pricing Page uses these in browser
# If you don't have Products yet, leave dummy and create later.
# Example: Pro = $45, Enterprise = $109
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxxxxxx

# ============================================
# 8. CLOUDFLARE DEPLOY - Final Checklist
# ============================================
# After filling .env.local, do same in Cloudflare:
# Cloudflare Dashboard > Workers & Pages > Your Project > Settings > Variables
# Add ALL these as Variables / Secrets:
# BETTER_AUTH_SECRET, BETTER_AUTH_URL, NEXT_PUBLIC_APP_URL,
# RESEND_API_KEY, RESEND_FROM, VELORA_KEYS,
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY,
# NEXT_PUBLIC_STRIPE_PRICE_PRO, NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE
# Then go to Deployments > Redeploy
# Your site will be live at: https://your-site.workers.dev
# ============================================
